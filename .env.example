# ---------------------------------------------------------------------------
# Yantric Things — environment (replaces the old PHP config.php)
# Copy to `.env` for local dev (`npm run dev`).
# In production, set these as real environment variables (hPanel / PM2 / systemd / Docker).
# ---------------------------------------------------------------------------

# MySQL — from Hostinger hPanel -> Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u938496972_CANvision
DB_USER=u938496972_CANvision
DB_PASS=
DB_CHARSET=utf8mb4

# HMAC secret for API bearer tokens (was config.php 'token_secret'). CHANGE THIS.
# Use the same value as your PHP config if you want tokens already issued to keep working.
TOKEN_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_SECONDS=604800

# Comma-separated list (was config.php 'cors_origins')
CORS_ORIGINS=https://yantricthings.com,https://www.yantricthings.com,http://localhost,http://127.0.0.1

# Shown by GET /api/health
SERVICE_NAME=VehicleIQ
APP_MODE=experiment

# Hotlink protection for images (was an Apache .htaccess rule). Set to "off" to disable.
HOTLINK_PROTECTION=on

# --- adapter-node runtime settings (read by `node build`) ---
PORT=3000
HOST=0.0.0.0
# Public origin of the site, needed behind a reverse proxy / HTTPS:
# ORIGIN=https://yantricthings.com
# PHP accepted up to ~8 MB request bodies; adapter-node defaults to 512 KB.
# Diagnostic report/log uploads can be larger, so raise it:
BODY_SIZE_LIMIT=8M
